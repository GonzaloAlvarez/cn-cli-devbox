#!/usr/bin/env python3
"""clouddevbox - manage cloud devboxes (cn-cdk-devbox stacks) in us-east-2.

Boxes are identified by EC2 instance tags (devbox:name / devbox:managed-by);
CloudFormation stacks Devbox-<name> own their lifecycle. Access is tailnet
SSH (headscale at hs.gn.al) or SSM Session Manager - no open ports.

Every run creates a throwaway venv (boto3 + bullet, its pip upgraded) under
./.clouddevbox in the current directory and removes it on exit, amun-style:
nothing persists.

No key path or name is hardcoded, only the owner email: the ssh key (VPS +
devbox login) resolves per run to the first key that authenticates to the
VPS - CLOUDDEVBOX_SSH_KEY if set, else every ~/.ssh key whose comment holds
EMAIL, else every kauket ssh.* secret into a throwaway tmp dir (ssh_key()).
"""
import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "1.5.0"

REGION = "us-east-2"
VPS_HOST = "hs.gn.al"
VPS_USER = "gonzalo"
EMAIL = "gonzaloab@gmail.com"
SSH_DIR = str(Path.home() / ".ssh")
# The kauket-canonical master-key install paths (kauket get
# ssh.gonzalo_main_private_key); tried first, no .pub or comment needed.
CANONICAL_KEYS = ("gonzalo_main_private_key", "gonzalo_main_private_key.pem")
KAUKET_CLIENT_HOME = str(Path.home() / ".config" / "kauket-operator-client")
KAUKET_SSH_PREFIX = "ssh."
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
            "-o", "ConnectTimeout=15"]
HS_CONTAINER = "cloudnet-headscale-1"
HS_USER_ID_FALLBACK = "2"
SOCKS_HOST, SOCKS_PORT = "127.0.0.1", 1055
CDK_REPO_URL = "https://github.com/GonzaloAlvarez/cn-cdk-devbox"

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,22}[a-z0-9]$")
AUTOSTOP_RE = re.compile(r"^([0-9]+[hm]|off)$")
KEY_RE = re.compile(r"^[A-Za-z0-9_-]{32,}$")
TYPE_RE = re.compile(r"^[a-z][a-z0-9-]*\.[a-z0-9]+$")
PLUGIN_RE = re.compile(r"^[a-z0-9-]+$")
# <name>:<path> in copy args; the name part is NAME_RE-shaped, so local
# paths that merely contain a colon ('./odd:file', '/abs:path') stay local.
REMOTE_RE = re.compile(r"^([a-z][a-z0-9-]{0,22}[a-z0-9]):(.*)$")

LIVE_STATES = ["pending", "running", "stopping", "stopped", "shutting-down"]

WORKDIR = Path.cwd() / ".clouddevbox"


class CliError(Exception):
    pass


# ---------------------------------------------------------------------------
# throwaway venv bootstrap (amun-style: fresh slate every run, cleanup on exit)
# ---------------------------------------------------------------------------
def _cleanup():
    shutil.rmtree(WORKDIR, ignore_errors=True)
    if _SSH_KEY_TMPDIR:
        shutil.rmtree(_SSH_KEY_TMPDIR, ignore_errors=True)


def _bootstrap():
    try:
        import boto3  # noqa: F401
        import bullet  # noqa: F401
        return
    except ImportError:
        pass
    if os.environ.get("CLOUDDEVBOX_REEXEC"):
        sys.exit("clouddevbox: deps still missing after venv bootstrap")
    _cleanup()
    venv = WORKDIR / "venv"
    print("bootstrapping throwaway venv (boto3 + bullet)...", file=sys.stderr)
    try:
        subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
        # venv's bundled pip lags PyPI and nags on every run; upgrade it
        # in-venv only (never the interpreter's global pip)
        subprocess.run([str(venv / "bin" / "python"), "-m", "pip", "install",
                        "--quiet", "--upgrade", "pip"], check=True)
        subprocess.run([str(venv / "bin" / "pip"), "install", "--quiet",
                        "boto3", "bullet"], check=True)
    except BaseException:
        _cleanup()
        raise
    env = dict(os.environ, CLOUDDEVBOX_REEXEC="1")
    os.execve(str(venv / "bin" / "python"),
              [str(venv / "bin" / "python"), os.path.abspath(__file__)] + sys.argv[1:], env)


# ---------------------------------------------------------------------------
# ssh key resolution. Candidates, in order: the kauket-canonical master-key
# paths (CANONICAL_KEYS — what `kauket get ssh.gonzalo_main_private_key`
# installs, so a freshly enrolled machine needs no .pub/comment fiddling),
# then ~/.ssh keys identified by EMAIL in the .pub (or embedded) comment.
# Every candidate is probed against the VPS; if none authenticate, every
# granted kauket ssh.* secret is fetched into a throwaway tmp dir and
# probed too.
# ---------------------------------------------------------------------------
_SSH_KEY_CACHE = None
_SSH_KEY_TMPDIR = None


def _candidate_keys():
    """Private keys under ~/.ssh: the kauket-canonical master-key paths
    first (no .pub or comment needed), then keys associated with EMAIL via
    a companion .pub or an embedded comment ssh-keygen -l can surface."""
    found = []
    ssh_dir = Path(SSH_DIR)
    if not ssh_dir.is_dir():
        return found
    for name in CANONICAL_KEYS:
        priv = ssh_dir / name
        try:
            with open(priv, "rb") as f:
                if b"PRIVATE KEY" in f.read(80):
                    found.append(str(priv))
        except OSError:
            pass
    for priv in sorted(ssh_dir.iterdir()):
        if priv.suffix == ".pub" or not priv.is_file():
            continue
        if str(priv) in found:
            continue
        try:
            with open(priv, "rb") as f:
                if b"PRIVATE KEY" not in f.read(80):
                    continue
        except OSError:
            continue
        pub = priv.with_name(priv.name + ".pub")
        if pub.is_file():
            try:
                if EMAIL in pub.read_text():
                    found.append(str(priv))
            except OSError:
                pass
        else:
            try:
                p = subprocess.run(["ssh-keygen", "-l", "-f", str(priv)],
                                   capture_output=True, text=True, timeout=10,
                                   stdin=subprocess.DEVNULL)
                if p.returncode == 0 and EMAIL in p.stdout:
                    found.append(str(priv))
            except (subprocess.TimeoutExpired, OSError):
                pass
    return found


def _key_works(path):
    """True when the key authenticates to the VPS - the same identity the
    devboxes trust (their authorized_keys holds the master public key)."""
    try:
        p = subprocess.run(["ssh", *SSH_OPTS, "-o", "IdentitiesOnly=yes",
                            "-i", path, "-l", VPS_USER, VPS_HOST, "true"],
                           capture_output=True, timeout=45)
        return p.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        return False


def _default_kauket_homes():
    """Kauket base homes to try, mirroring kauket's own default
    (os.UserConfigDir()/kauket) plus the legacy operator-client home."""
    if sys.platform == "darwin":
        default = Path.home() / "Library" / "Application Support" / "kauket"
    else:
        base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
        default = Path(base) / "kauket"
    return [str(default), KAUKET_CLIENT_HOME]


def _kauket_client():
    """(kauket_binary, env-with-KAUKET_HOME), or (None, why-not)."""
    kauket = shutil.which("kauket")
    if not kauket:
        return None, "kauket is not on PATH"
    env_home = os.environ.get("KAUKET_HOME")
    homes = [env_home] if env_home else _default_kauket_homes()
    for home in homes:
        if Path(home).is_dir():
            return kauket, dict(os.environ, KAUKET_HOME=home)
    return None, f"no kauket client home at {' or '.join(homes)}"


def _kauket_fetch_ssh_keys(kauket, env):
    """Fetch every granted ssh.* secret into the run's tmp dir (0600 files
    in a 0700 dir removed on exit); returns the written paths."""
    global _SSH_KEY_TMPDIR
    try:
        p = subprocess.run([kauket, "list"], capture_output=True, text=True,
                           timeout=120, env=env)
    except subprocess.TimeoutExpired:
        raise CliError("kauket list timed out")
    if p.returncode != 0:
        raise CliError(f"kauket list failed: {(p.stderr or p.stdout).strip()}")
    ids = [line.split()[0] for line in p.stdout.splitlines()
           if line.strip() and line.split()[0].startswith(KAUKET_SSH_PREFIX)]
    paths = []
    for sid in ids:
        content = None
        # --no-sync first: decrypts from the local store clone (fast,
        # offline); the retry syncs for a bundle updated since.
        for extra in (["--no-sync"], []):
            try:
                g = subprocess.run([kauket, "get", sid, "--stdout", *extra],
                                   capture_output=True, timeout=120, env=env)
            except subprocess.TimeoutExpired:
                continue
            if g.returncode == 0 and g.stdout:
                content = g.stdout
                break
        if content is None:
            print(f"warning: kauket get {sid} failed, skipping", file=sys.stderr)
            continue
        if _SSH_KEY_TMPDIR is None:
            _SSH_KEY_TMPDIR = tempfile.mkdtemp(prefix="clouddevbox-")
        key = Path(_SSH_KEY_TMPDIR) / sid
        key.touch(mode=0o600)
        key.write_bytes(content)
        paths.append(str(key))
    return paths


def ssh_key():
    """Path to a working private key for the VPS and devbox ssh, resolved
    once per run: CLOUDDEVBOX_SSH_KEY wins if set; otherwise the first
    candidate (kauket-canonical paths, then EMAIL-tagged ~/.ssh keys) that
    authenticates to the VPS, then the first working kauket ssh.* secret."""
    global _SSH_KEY_CACHE
    if _SSH_KEY_CACHE:
        return _SSH_KEY_CACHE
    override = os.environ.get("CLOUDDEVBOX_SSH_KEY")
    if override:
        path = Path(override).expanduser()
        if not path.is_file():
            raise CliError(f"CLOUDDEVBOX_SSH_KEY={override} is not a file")
        _SSH_KEY_CACHE = str(path)
        return _SSH_KEY_CACHE
    local = _candidate_keys()
    for cand in local:
        if _key_works(cand):
            _SSH_KEY_CACHE = cand
            return cand
    print((f"none of {len(local)} ~/.ssh key(s) tagged {EMAIL} authenticate to "
           f"{VPS_HOST}" if local else f"no ~/.ssh key tagged {EMAIL}")
          + "; trying kauket...", file=sys.stderr)
    hint = (f"fix one of:\n"
            f"  - install the master key at its canonical path:\n"
            f"      kauket get ssh.gonzalo_main_private_key\n"
            f"    (first time: kauket request ssh.gonzalo_main_private_key enrolls this\n"
            f"     machine, then `kauket approve` from the admin machine)\n"
            f"  - hold a working key in {SSH_DIR} whose .pub comment contains {EMAIL}\n"
            f"  - point CLOUDDEVBOX_SSH_KEY at a working key file")
    kauket, env = _kauket_client()
    if kauket is None:
        raise CliError(f"no working ssh key for {VPS_USER}@{VPS_HOST} ({env}); {hint}")
    fetched = _kauket_fetch_ssh_keys(kauket, env)
    for cand in fetched:
        if _key_works(cand):
            _SSH_KEY_CACHE = cand
            return cand
    raise CliError(
        f"no working ssh key for {VPS_USER}@{VPS_HOST}: {len(local)} local candidate(s)"
        f" and {len(fetched)} kauket ssh.* secret(s) all failed to authenticate"
        f" (is {VPS_HOST} reachable?); {hint}")


# ---------------------------------------------------------------------------
# headscale over VPS ssh
# ---------------------------------------------------------------------------
def vps_run(cmd, timeout=90):
    try:
        p = subprocess.run(["ssh", *SSH_OPTS, "-i", ssh_key(), "-l", VPS_USER, VPS_HOST, cmd],
                           capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise CliError(f"ssh to {VPS_HOST} timed out running: {cmd}")
    if p.returncode != 0:
        raise CliError(f"command on {VPS_HOST} failed: {cmd}\n{p.stderr.strip() or p.stdout.strip()}")
    return p.stdout


def headscale(args, timeout=90):
    return vps_run(f"docker exec {HS_CONTAINER} headscale {args}", timeout)


def _field(d, *names, default=None):
    for n in names:
        if isinstance(d, dict) and d.get(n) is not None:
            return d[n]
    return default


def parse_nodes(raw):
    """headscale `nodes list -o json` -> {hostname: {id, online, ip, last_seen}}
    for tag:devbox nodes. Tolerates camelCase and snake_case field names;
    v0.28 puts preauthkey tags under plain "tags" and encodes last_seen as a
    protobuf {seconds, nanos} object."""
    nodes = json.loads(raw)
    if isinstance(nodes, dict):
        nodes = nodes.get("nodes") or nodes.get("machines") or []
    out = {}
    for n in nodes or []:
        tags = set()
        for key in ("tags", "forcedTags", "forced_tags", "validTags", "valid_tags"):
            tags.update(n.get(key) or [])
        if "tag:devbox" not in tags:
            continue
        host = _field(n, "givenName", "given_name", "name", default="")
        ips = _field(n, "ipAddresses", "ip_addresses", default=[]) or []
        v4 = next((ip for ip in ips if ip.startswith("100.")), ips[0] if ips else None)
        last_seen = _field(n, "lastSeen", "last_seen")
        if isinstance(last_seen, dict):
            last_seen = last_seen.get("seconds")
        out[host] = {
            "id": str(_field(n, "id", default="")),
            "online": bool(_field(n, "online", default=False)),
            "ip": v4,
            "last_seen": last_seen,
        }
    return out


def hs_nodes():
    """Returns the devbox node map, or None when the tailnet control plane
    is unreachable (callers degrade gracefully)."""
    try:
        return parse_nodes(headscale("nodes list -o json"))
    except (CliError, json.JSONDecodeError):
        return None


def hs_user_id():
    try:
        users = json.loads(headscale("users list -o json"))
        for u in users or []:
            if _field(u, "email", default="") == EMAIL:
                return str(_field(u, "id"))
    except (CliError, json.JSONDecodeError):
        pass
    return HS_USER_ID_FALLBACK


def hs_mint_key():
    out = headscale(f"preauthkeys create --user {hs_user_id()} --tags tag:devbox --expiration 1h")
    for line in reversed(out.strip().splitlines()):
        line = line.strip()
        if KEY_RE.match(line):
            return line
    raise CliError(f"could not parse a preauth key out of headscale output:\n{out}")


def hs_delete_node(node_id):
    headscale(f"nodes delete --identifier {node_id} --force")


# ---------------------------------------------------------------------------
# AWS session / EC2 helpers
# ---------------------------------------------------------------------------
def _available_profiles():
    import boto3
    return list(boto3.session.Session().available_profiles)


def select_profile():
    """Resolve the AWS profile for runs that omit --profile: a single
    configured profile is used as-is (tty or not); more than one opens an
    interactive bullet picker, which needs a tty, so scripts on multi-profile
    machines keep passing --profile explicitly."""
    profiles = _available_profiles()
    if not profiles:
        raise CliError("no AWS profiles found in ~/.aws/config or ~/.aws/credentials")
    if len(profiles) == 1:
        print(f"using the only configured AWS profile: {profiles[0]}")
        return profiles[0]
    if not sys.stdin.isatty():
        raise CliError("--profile is required when stdin is not a tty")
    from bullet import Bullet
    return Bullet(
        prompt="Select AWS Profile:",
        choices=profiles,
        indent=0,
        align=5,
        margin=1,
        shift=0,
        bullet="→",
        pad_right=5,
    ).launch()


def make_session(profile):
    import boto3
    import botocore.exceptions as bex
    sso_errors = tuple(getattr(bex, n) for n in
                       ("SSOTokenLoadError", "TokenRetrievalError",
                        "UnauthorizedSSOTokenError", "SSOError")
                       if hasattr(bex, n))
    try:
        session = boto3.Session(profile_name=profile, region_name=REGION)
        account = session.client("sts").get_caller_identity()["Account"]
        return session, account
    except bex.ProfileNotFound:
        raise CliError(f"AWS profile '{profile}' not found in ~/.aws/config or ~/.aws/credentials")
    except sso_errors:
        raise CliError(f"SSO credentials for '{profile}' are missing or expired; run:\n"
                       f"  aws sso login --profile {profile}")
    except bex.NoCredentialsError:
        raise CliError(f"no credentials available for profile '{profile}'")
    except bex.ClientError as e:
        code = e.response.get("Error", {}).get("Code", "")
        if "Expired" in code or code in ("InvalidClientTokenId", "AccessDenied"):
            raise CliError(f"credentials for '{profile}' were rejected ({code}); if this is an "
                           f"SSO profile, run: aws sso login --profile {profile}")
        raise


def find_instance(ec2, name, states=None):
    r = ec2.describe_instances(Filters=[
        {"Name": "tag:devbox:name", "Values": [name]},
        {"Name": "tag:devbox:managed-by", "Values": ["clouddevbox"]},
        {"Name": "instance-state-name", "Values": states or LIVE_STATES},
    ])
    for res in r["Reservations"]:
        for i in res["Instances"]:
            return i
    return None


def all_instances(ec2):
    r = ec2.describe_instances(Filters=[
        {"Name": "tag:devbox:managed-by", "Values": ["clouddevbox"]},
        {"Name": "instance-state-name", "Values": LIVE_STATES},
    ])
    out = []
    for res in r["Reservations"]:
        out.extend(res["Instances"])
    return out


def instance_tag(instance, key):
    for t in instance.get("Tags", []):
        if t["Key"] == key:
            return t["Value"]
    return None


def stack_status(cfn, name):
    import botocore.exceptions as bex
    try:
        stacks = cfn.describe_stacks(StackName=f"Devbox-{name}")["Stacks"]
        return stacks[0]["StackStatus"], stacks[0]["StackId"], stacks[0]
    except bex.ClientError as e:
        if "does not exist" in str(e):
            return None, None, None
        raise


def stack_output(stack, key):
    for o in stack.get("Outputs", []):
        if o["OutputKey"] == key:
            return o["OutputValue"]
    return None


# ---------------------------------------------------------------------------
# cdk toolchain (ephemeral, inside the cn-cdk-devbox checkout)
# ---------------------------------------------------------------------------
def resolve_cdk_repo():
    override = os.environ.get("CLOUDDEVBOX_CDK_REPO")
    if override:
        p = Path(override).expanduser()
        if not (p / "cdk.json").exists():
            raise CliError(f"CLOUDDEVBOX_CDK_REPO={override} is not a cn-cdk-devbox checkout")
        return p
    p = Path.home() / "dev" / "cn-cdk-devbox"
    if (p / "cdk.json").exists():
        return p
    clone = WORKDIR / "cn-cdk-devbox"
    if not (clone / "cdk.json").exists():
        print(f"cloning {CDK_REPO_URL} (no local checkout found)...")
        WORKDIR.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "--quiet", "--depth", "1", CDK_REPO_URL, str(clone)],
                       check=True)
    return clone


def cdk_deploy(repo, profile, account, stacks, context):
    if not shutil.which("node"):
        raise CliError("node not found on PATH (the CDK needs it); install via asdf/brew")
    base_python = shutil.which("python3") or sys.executable
    venv, npm = repo / ".venv", repo / ".npm"
    env = dict(os.environ, AWS_PROFILE=profile, AWS_ACCOUNT_ID=account)
    env["PATH"] = f"{venv}/bin:" + env.get("PATH", "")
    try:
        print("preparing cdk toolchain (throwaway .venv/.npm in the checkout)...")
        subprocess.run([base_python, "-m", "venv", str(venv)], check=True)
        subprocess.run([str(venv / "bin" / "python"), "-m", "pip", "install",
                        "--quiet", "--upgrade", "pip"], check=True)
        subprocess.run([str(venv / "bin" / "pip"), "install", "--quiet", "-r",
                        str(repo / "requirements.txt")], check=True)
        subprocess.run(["npm", "install", "--prefix", str(npm), "--silent", "aws-cdk"],
                       cwd=repo, check=True)
        cdk_bin = npm / "node_modules" / ".bin" / "cdk"
        ctx = [a for k, v in context.items() for a in ("-c", f"{k}={v}")]
        cmd = [str(cdk_bin), "deploy", *stacks, *ctx, "--require-approval", "never"]
        print("+", " ".join(cmd))
        rc = subprocess.run(cmd, cwd=repo, env=env).returncode
        if rc != 0:
            raise CliError(f"cdk deploy failed (rc={rc}); if the stack is stuck half-created, "
                           f"run: clouddevbox destroy {context.get('box')} --profile {profile}")
    finally:
        shutil.rmtree(venv, ignore_errors=True)
        shutil.rmtree(npm, ignore_errors=True)


# ---------------------------------------------------------------------------
# waits
# ---------------------------------------------------------------------------
def wait_ssm_online(session, iid, timeout=900):
    ssm = session.client("ssm")
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = ssm.describe_instance_information(
            Filters=[{"Key": "InstanceIds", "Values": [iid]}])
        infos = r.get("InstanceInformationList", [])
        if infos and infos[0].get("PingStatus") == "Online":
            return
        time.sleep(10)
    raise CliError(f"instance {iid} never registered with SSM (waited {timeout}s)")


def wait_tailnet_online(name, timeout=600, want_online=True):
    deadline = time.time() + timeout
    while time.time() < deadline:
        nodes = hs_nodes() or {}
        info = nodes.get(f"devbox-{name}")
        if info and info["online"] == want_online:
            return info
        time.sleep(15)
    raise CliError(f"devbox-{name} did not appear {'online' if want_online else 'offline'} "
                   f"on the tailnet (waited {timeout}s)")


def ssm_shell(session, iid, commands, timeout=90):
    """Run a short root shell script on the box via SSM; returns stdout."""
    ssm = session.client("ssm")
    cmd = ssm.send_command(InstanceIds=[iid], DocumentName="AWS-RunShellScript",
                           Parameters={"commands": commands})
    cid = cmd["Command"]["CommandId"]
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(2)
        inv = ssm.get_command_invocation(CommandId=cid, InstanceId=iid)
        if inv["Status"] in ("Success", "Failed", "Cancelled", "TimedOut"):
            if inv["Status"] != "Success":
                raise CliError(f"ssm command {inv['Status']}: {inv.get('StandardErrorContent', '')[:400]}")
            return inv.get("StandardOutputContent", "")
    raise CliError("ssm command did not finish in time")


def _tcp_reachable(host, port, timeout):
    try:
        socket.create_connection((host, port), timeout).close()
        return True
    except OSError:
        return False


def humanize_age(launch_time):
    delta = datetime.datetime.now(datetime.timezone.utc) - launch_time
    secs = int(delta.total_seconds())
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h"
    return f"{secs // 86400}d"


# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------
def cmd_new(args, session, account):
    name = args.name
    if not NAME_RE.match(name) or name == "base":
        raise CliError(f"invalid name '{name}': lowercase alphanumeric + dashes, 2-24 chars")
    if not TYPE_RE.match(args.type):
        raise CliError(f"invalid instance type '{args.type}'")
    if not 8 <= args.disk <= 2000:
        raise CliError(f"invalid disk size {args.disk} GiB (8-2000)")
    if not AUTOSTOP_RE.match(args.autostop):
        raise CliError(f"invalid autostop '{args.autostop}': use <N>h, <N>m or off")
    plugins = [p for p in args.plugins.split(",") if p]
    for p in plugins:
        if not PLUGIN_RE.match(p):
            raise CliError(f"invalid plugin name '{p}' (maps to the amun-<plugin> repo)")

    ec2 = session.client("ec2")
    cfn = session.client("cloudformation")

    if find_instance(ec2, name):
        raise CliError(f"a devbox named '{name}' already exists (see: clouddevbox list)")
    status, _, _ = stack_status(cfn, name)
    if status and status != "DELETE_COMPLETE":
        raise CliError(f"CloudFormation stack Devbox-{name} already exists ({status}); "
                       f"destroy it first")
    nodes = hs_nodes()
    if nodes is None:
        raise CliError(f"cannot reach headscale via {VPS_HOST} - needed to mint the tailnet key")
    if f"devbox-{name}" in nodes:
        # don't suggest a raw `ssh hs.gn.al` one-liner: it silently fails on
        # machines whose local username differs from the VPS user (no -l, no
        # key); destroy reuses this run's authenticated ssh path and also
        # sweeps leftover /devbox/<name>/* parameters.
        raise CliError(f"stale headscale node 'devbox-{name}' exists "
                       f"(id {nodes[f'devbox-{name}']['id']}); remove it first: "
                       f"clouddevbox destroy {name} --profile {args.profile}")

    repo = resolve_cdk_repo()

    print(f"minting one-shot headscale preauth key (tag:devbox, 1h expiry)...")
    key = hs_mint_key()
    ssm = session.client("ssm")
    param = f"/devbox/{name}/ts-authkey"
    ssm.put_parameter(Name=param, Value=key, Type="SecureString", Overwrite=True)
    print(f"staged key at SSM parameter {param}")

    try:
        cdk_deploy(repo, args.profile, account, ["DevboxBase", f"Devbox-{name}"], {
            "box": name, "type": args.type, "disk": str(args.disk),
            "plugins": ",".join(plugins), "autostop": args.autostop,
        })
        _, _, stack = stack_status(cfn, name)
        iid = stack_output(stack, "instanceid")
        if not iid:
            raise CliError(f"stack Devbox-{name} has no instanceid output")
        print(f"instance {iid} created; waiting for it to run...")
        ec2.get_waiter("instance_running").wait(InstanceIds=[iid])
        print("waiting for SSM agent registration (break-glass access)...")
        wait_ssm_online(session, iid)
        print("waiting for the box to join the tailnet...")
        info = wait_tailnet_online(name)
    finally:
        try:
            ssm.delete_parameter(Name=param)
            print(f"deleted SSM parameter {param}")
        except Exception as e:
            # not fatal (keys are one-shot + 1h expiry, and destroy sweeps
            # /devbox/<name>/*) but never fail silently
            print(f"warning: could not delete {param}: {e}", file=sys.stderr)

    print(f"""
devbox '{name}' is up
  dns:        {name}.devbox.lab.gn.al -> {info['ip']}
              (tailnet split-DNS; from socksnode --exit-lan mode names under
              lab.gn.al don't resolve - use the IP or clouddevbox ssh)
  ssh:        clouddevbox ssh {name} --profile {args.profile}
              (socks proxy 127.0.0.1:1055 must be up: ~/dev/cn-socksnode/run.sh)
  ssm:        clouddevbox ssm {name} --profile {args.profile}
              (lands as ssm-user; sudo su - gonzalo)
  autostop:   {args.autostop} after each boot (clouddevbox autostop {name} 10h|off)
  note:       amun bootstrap keeps running ~5-8 min after the tailnet join;
              clouddevbox status {name} --profile {args.profile} shows completion""")


def cmd_list(args, session, account):
    ec2 = session.client("ec2")
    instances = all_instances(ec2)
    nodes = hs_nodes()
    rows = []
    for i in instances:
        name = instance_tag(i, "devbox:name") or "?"
        node = (nodes or {}).get(f"devbox-{name}")
        if nodes is None:
            tailnet = "?"
        elif node is None:
            tailnet = "-"
        else:
            tailnet = (node["ip"] or "?") + ("" if node["online"] else " (offline)")
        rows.append((name, i["State"]["Name"], i["InstanceType"], tailnet,
                     humanize_age(i["LaunchTime"])))
    rows.sort()
    header = ("NAME", "STATE", "TYPE", "TAILNET-IP", "AGE")
    widths = [max(len(str(r[c])) for r in [header, *rows]) for c in range(len(header))]
    for r in [header, *rows]:
        print("  ".join(str(v).ljust(widths[c]) for c, v in enumerate(r)))
    if not rows:
        print("(no devboxes)")


def _require_instance(session, name, states=None):
    i = find_instance(session.client("ec2"), name, states)
    if not i:
        raise CliError(f"no devbox named '{name}' (see: clouddevbox list)")
    return i


def cmd_start(args, session, account):
    i = _require_instance(session, args.name)
    if i["State"]["Name"] == "running":
        print(f"devbox '{args.name}' is already running")
        return
    ec2 = session.client("ec2")
    ec2.start_instances(InstanceIds=[i["InstanceId"]])
    print(f"starting {i['InstanceId']}...")
    ec2.get_waiter("instance_running").wait(InstanceIds=[i["InstanceId"]])
    print("instance running; waiting for the tailnet...")
    wait_tailnet_online(args.name, timeout=300)
    print(f"devbox '{args.name}' is up (autostop clock restarted)")


def cmd_stop(args, session, account):
    i = _require_instance(session, args.name)
    if i["State"]["Name"] == "stopped":
        print(f"devbox '{args.name}' is already stopped")
        return
    ec2 = session.client("ec2")
    ec2.stop_instances(InstanceIds=[i["InstanceId"]])
    print(f"stopping {i['InstanceId']}...")
    ec2.get_waiter("instance_stopped").wait(InstanceIds=[i["InstanceId"]])
    print(f"devbox '{args.name}' stopped (costs only its EBS volume now)")


def cmd_autostop(args, session, account):
    if not AUTOSTOP_RE.match(args.value):
        raise CliError(f"invalid autostop '{args.value}': use <N>h, <N>m or off "
                       f"(e.g. 6h, 10h, 90m)")
    i = _require_instance(session, args.name)
    if i["State"]["Name"] != "running":
        raise CliError(f"devbox '{args.name}' is {i['State']['Name']}; autostop can only be "
                       f"changed while it runs (the value persists across stops)")
    out = ssm_shell(session, i["InstanceId"], [
        f"echo '{args.value}' > /etc/clouddevbox/autostop",
        "cat /etc/clouddevbox/autostop",
    ])
    print(f"autostop for '{args.name}' set to: {out.strip()}"
          + ("" if args.value == "off" else " (measured from each boot, checked every 5 min)"))


def cmd_destroy(args, session, account):
    cfn = session.client("cloudformation")
    status, stack_id, _ = stack_status(cfn, args.name)
    nodes = hs_nodes() or {}
    node = nodes.get(f"devbox-{args.name}")

    if not status and not node:
        print(f"nothing to destroy for '{args.name}' (no stack, no tailnet node); "
              f"sweeping leftover SSM parameters")
        args.yes = True
    if not args.yes:
        reply = input(f"destroy devbox '{args.name}' (stack Devbox-{args.name}, instance + "
                      f"volume + tailnet node)? [y/N] ")
        if reply.strip().lower() not in ("y", "yes"):
            print("aborted")
            return

    if status:
        print(f"deleting CloudFormation stack Devbox-{args.name} ({status})...")
        cfn.delete_stack(StackName=stack_id)
        cfn.get_waiter("stack_delete_complete").wait(StackName=stack_id)
        print("stack deleted")
    if node:
        print(f"removing headscale node devbox-{args.name} (id {node['id']})...")
        try:
            hs_delete_node(node["id"])
        except CliError as e:
            print(f"warning: could not delete the headscale node - remove it manually:\n{e}")
    ssm = session.client("ssm")
    params = ssm.get_parameters_by_path(Path=f"/devbox/{args.name}", Recursive=True)
    names = [p["Name"] for p in params.get("Parameters", [])]
    if names:
        ssm.delete_parameters(Names=names)
        print(f"deleted SSM parameters: {', '.join(names)}")
    print(f"devbox '{args.name}' destroyed")


def tailnet_route(name, profile):
    """Resolve devbox-<name> on the tailnet and pick the network path.
    Returns (target, opts): the tailnet IP (or MagicDNS name) plus the
    common ssh/scp option argv - deliberately without -l/user, because scp
    reuses -l as a bandwidth limit; callers add the user themselves."""
    nodes = hs_nodes()
    info = (nodes or {}).get(f"devbox-{name}")
    if not info:
        raise CliError(f"devbox-{name} is not on the tailnet"
                       + ("" if nodes is not None else f" (headscale unreachable)")
                       + "; try: clouddevbox ssh --ssm")
    if not info["online"]:
        raise CliError(f"devbox-{name} is offline (stopped?); "
                       f"clouddevbox start {name} --profile {profile}")
    target = info["ip"] or f"devbox-{name}.ts.gn.al"
    # Path selection: prefer the socks proxy (the Mac's only tailnet doorway,
    # at home or away); fall back to a direct connection for machines with a
    # native tailnet route (e.g. running this from one devbox to another).
    # Ephemeral boxes recycle tailnet IPs, so pinning host keys would break
    # every successor box; trusted-network no-verify combo per CLAUDE.md §4.2.
    opts = ["-o", "UserKnownHostsFile=/dev/null", "-o", "StrictHostKeyChecking=no",
            "-o", "LogLevel=ERROR",
            "-i", ssh_key()]
    if _tcp_reachable(SOCKS_HOST, SOCKS_PORT, 1.5):
        opts += ["-o", f"ProxyCommand=nc -x {SOCKS_HOST}:{SOCKS_PORT} %h %p"]
    elif info["ip"] and _tcp_reachable(info["ip"], 22, 3):
        pass
    else:
        raise CliError(f"no path to devbox-{name}: socks proxy "
                       f"{SOCKS_HOST}:{SOCKS_PORT} is down and {target}:22 is not "
                       f"directly reachable; start cn-socksnode "
                       f"(~/dev/cn-socksnode/run.sh) or use: clouddevbox ssm {name}")
    return target, opts


def cmd_ssh(args, session, account):
    if args.ssm:
        return cmd_ssm(args, session, account)
    target, opts = tailnet_route(args.name, args.profile)
    cmd = ["ssh", *opts, "-l", VPS_USER, target, *args.command]
    if getattr(args, "show", False):
        print("+ " + shlex.join(cmd))
    rc = subprocess.run(cmd).returncode
    sys.exit(rc)


def cmd_ssm(args, session, account):
    if not shutil.which("aws"):
        raise CliError("aws CLI not found on PATH")
    if not shutil.which("session-manager-plugin"):
        raise CliError("session-manager-plugin not found on PATH; install it via gear:\n"
                       "  ~/.gear/com/session-manager-plugin/setup-darwin")
    i = _require_instance(session, args.name, states=["running"])
    cmd = ["aws", "ssm", "start-session", "--target", i["InstanceId"],
           "--region", REGION, "--profile", args.profile]
    if getattr(args, "show", False):
        print("+ " + shlex.join(cmd))
    rc = subprocess.run(cmd).returncode
    sys.exit(rc)


def _split_remote(spec):
    """(name, path) when spec looks like <name>:<path>, else None."""
    m = REMOTE_RE.match(spec)
    return (m.group(1), m.group(2)) if m else None


def cmd_copy(args, session, account):
    src, dst = _split_remote(args.src), _split_remote(args.dst)
    if bool(src) == bool(dst):
        raise CliError("exactly one of src/dst must be <name>:<path> "
                       "(e.g. clouddevbox copy report.txt alpha:/tmp/); "
                       "prefix a local path containing ':' with ./")
    name, rpath = src or dst
    target, opts = tailnet_route(name, args.profile)
    # scp reuses -l as a bandwidth limit, hence user@host instead of -l.
    remote = f"{VPS_USER}@{target}:{rpath}"
    cmd = (["scp", *opts, remote, args.dst] if src
           else ["scp", *opts, args.src, remote])
    if args.show:
        print("+ " + shlex.join(cmd))
    sys.exit(subprocess.run(cmd).returncode)


def cmd_tun(args, session, account):
    for port, which in ((args.local_port, "local"), (args.remote_port, "remote")):
        if not 1 <= port <= 65535:
            raise CliError(f"invalid {which} port {port} (1-65535)")
    target, opts = tailnet_route(args.name, args.profile)
    cmd = ["ssh", *opts, "-l", VPS_USER, "-N",
           "-L", f"{args.local_port}:127.0.0.1:{args.remote_port}", target]
    if args.show:
        print("+ " + shlex.join(cmd))
    print(f"tunnel open: localhost:{args.local_port} -> devbox-{args.name}:"
          f"{args.remote_port} (ctrl-c to close; the box's autostop still applies)")
    sys.exit(subprocess.run(cmd).returncode)


def cmd_status(args, session, account):
    i = _require_instance(session, args.name)
    state = i["State"]["Name"]
    print(f"instance:  {i['InstanceId']} ({i['InstanceType']}) - {state}")
    nodes = hs_nodes()
    node = (nodes or {}).get(f"devbox-{args.name}")
    if nodes is None:
        print("tailnet:   ? (headscale unreachable)")
    elif node is None:
        print("tailnet:   not registered")
    else:
        print(f"tailnet:   {node['ip']} - {'online' if node['online'] else 'offline'}")
    if state == "running":
        try:
            # state vocabulary: "running" = fully provisioned (amun core +
            # every requested plugin done); "provisioning" = bootstrap still
            # working through them. Per-stage markers exist on boxes created
            # after 2026-07-22; older boxes fall back to the overall marker.
            out = ssm_shell(session, i["InstanceId"], [
                'wanted="$(cat /etc/clouddevbox/plugins 2>/dev/null)"',
                'finished="$(tr "\\n" " " < /var/lib/clouddevbox/provisioned'
                ' 2>/dev/null | sed "s/ $//")"',
                "if test -f /var/lib/clouddevbox/bootstrap-complete; then "
                'echo "state: running (fully provisioned${wanted:+: $wanted}; '
                'completed $(cat /var/lib/clouddevbox/bootstrap-complete))"; '
                "elif test -f /var/lib/clouddevbox/bootstrap-failed; then "
                'echo "state: provisioning FAILED at: '
                '$(cat /var/lib/clouddevbox/bootstrap-failed)'
                '${finished:+ (stages done: $finished)}"; '
                "else "
                'echo "state: provisioning${wanted:+ - wanted: $wanted}'
                '${finished:+ - done: $finished} '
                '(log: /var/log/devbox-bootstrap.log)"; fi',
                "echo autostop: $(cat /etc/clouddevbox/autostop 2>/dev/null || echo unknown)",
                "echo uptime: $(cut -d. -f1 /proc/uptime)s",
            ])
            for line in out.strip().splitlines():
                print(f"box:       {line}")
        except CliError as e:
            print(f"box:       (ssm query failed: {e})")


# ---------------------------------------------------------------------------
def build_parser():
    parser = argparse.ArgumentParser(
        prog="clouddevbox",
        description="Manage cloud devboxes (no open ports; tailnet SSH + SSM only; "
                    f"region {REGION}).")
    parser.add_argument("--version", action="version", version=f"clouddevbox {VERSION}")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--profile",
                        help="AWS profile (interactive picker when omitted; "
                             "account is derived via STS)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new", parents=[common], help="create a devbox")
    p.add_argument("name")
    p.add_argument("--type", default="m7g.large", help="EC2 instance type (default m7g.large)")
    p.add_argument("--disk", type=int, default=50, help="root gp3 GiB (default 50)")
    p.add_argument("--plugins", default="kauket",
                   help="comma-separated amun plugins after core (default: kauket)")
    p.add_argument("--autostop", default="6h", help="self-stop after this uptime (default 6h; off)")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("list", parents=[common], help="list devboxes")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("start", parents=[common], help="start a stopped devbox")
    p.add_argument("name")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("stop", parents=[common], help="stop a devbox (EBS-only cost)")
    p.add_argument("name")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("autostop", parents=[common],
                       help="set the self-stop timeout (e.g. 10h, 90m, off)")
    p.add_argument("name")
    p.add_argument("value")
    p.set_defaults(fn=cmd_autostop)

    p = sub.add_parser("destroy", parents=[common], help="destroy a devbox completely")
    p.add_argument("name")
    p.add_argument("--yes", action="store_true", help="skip confirmation")
    p.set_defaults(fn=cmd_destroy)

    p = sub.add_parser("ssh", parents=[common], help="ssh over the tailnet (socks proxy)")
    p.add_argument("name")
    p.add_argument("--ssm", action="store_true", help="use SSM Session Manager instead")
    p.add_argument("--show", action="store_true",
                   help="print the underlying ssh command before connecting")
    p.add_argument("command", nargs="*", help="optional remote command")
    p.set_defaults(fn=cmd_ssh)

    p = sub.add_parser("ssm", parents=[common], help="SSM Session Manager shell")
    p.add_argument("name")
    p.add_argument("--show", action="store_true",
                   help="print the underlying aws command before connecting")
    p.set_defaults(fn=cmd_ssm)

    p = sub.add_parser("copy", parents=[common],
                       help="scp a file to/from a devbox (<name>:<path>)")
    p.add_argument("src", help="local path or <name>:<path>")
    p.add_argument("dst", help="local path or <name>:<path>")
    p.add_argument("--show", action="store_true",
                   help="print the underlying scp command before copying")
    p.set_defaults(fn=cmd_copy)

    p = sub.add_parser("tun", parents=[common],
                       help="forward localhost:<local> to the devbox's 127.0.0.1:<remote>")
    p.add_argument("name")
    p.add_argument("local_port", type=int)
    p.add_argument("remote_port", type=int)
    p.add_argument("--show", action="store_true",
                   help="print the underlying ssh command before connecting")
    p.set_defaults(fn=cmd_tun)

    p = sub.add_parser("status", parents=[common], help="instance + tailnet + bootstrap state")
    p.add_argument("name")
    p.set_defaults(fn=cmd_status)

    return parser


def main():
    args = build_parser().parse_args()
    if not args.profile:
        # subcommand hints interpolate args.profile, so fill in the selection
        args.profile = select_profile()
    session, account = make_session(args.profile)
    args.fn(args, session, account)
    return 0


if __name__ == "__main__":
    _bootstrap()
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    try:
        sys.exit(main())
    except CliError as e:
        print(f"clouddevbox: {e}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
    finally:
        _cleanup()
